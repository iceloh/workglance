{
  "name": "workglance",
  "displayName": "Workglance: what every AI coding tab did",
  "description": "Five Claude Code tabs open? See which one needs you right now, what each one did across every repo, and whether the work really shipped. A task board your agents keep themselves. Local and private.",
  "version": "0.10.0",
  "publisher": "workglance",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#4f46e5",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iceloh/workglance"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "workglance.openBoard",
        "title": "Workglance: Open board"
      },
      {
        "command": "workglance.openInBrowser",
        "title": "Workglance: Open board in browser"
      },
      {
        "command": "workglance.install",
        "title": "Workglance: Install the local tool (npx workglance install)"
      }
    ],
    "configuration": {
      "title": "Workglance",
      "properties": {
        "workglance.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a tab asks you something or needs permission."
        },
        "workglance.pollSeconds": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "description": "How often to check the tabs' status."
        }
      }
    }
  },
  "keywords": [
    "claude",
    "claude code",
    "ai agents",
    "agents",
    "task board",
    "kanban",
    "mcp",
    "productivity",
    "worktree"
  ],
  "homepage": "https://github.com/iceloh/workglance#readme",
  "bugs": {
    "url": "https://github.com/iceloh/workglance/issues"
  }
}
